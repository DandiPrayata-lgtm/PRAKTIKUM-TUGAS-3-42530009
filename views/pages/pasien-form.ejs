<%- include('../partials/header', { pageTitle: pageTitle }) %>

<div class="card form-card">
  <h2><%= pageTitle %></h2>

  <form action="<%= formAction %>" method="POST">
    <div class="field">
      <label for="no_rekam_medis">No. Rekam Medis:</label>
      <input type="text" id="no_rekam_medis" name="no_rekam_medis" value="<%= pasien.no_rekam_medis %>" maxlength="20" placeholder="contoh: RM-0004" required>
    </div>

    <div class="field">
      <label for="nama_lengkap">Nama Lengkap:</label>
      <input type="text" id="nama_lengkap" name="nama_lengkap" value="<%= pasien.nama_lengkap %>" required>
    </div>

    <div class="field">
      <label for="jenis_kelamin">Jenis Kelamin:</label>
      <select id="jenis_kelamin" name="jenis_kelamin" required>
        <option value="Laki-laki" <%= pasien.jenis_kelamin === 'Laki-laki' ? 'selected' : '' %>>Laki-laki</option>
        <option value="Perempuan" <%= pasien.jenis_kelamin === 'Perempuan' ? 'selected' : '' %>>Perempuan</option>
      </select>
    </div>

    <div class="field">
      <label for="tanggal_lahir">Tanggal Lahir:</label>
      <input type="date" id="tanggal_lahir" name="tanggal_lahir" value="<%= pasien.tanggal_lahir %>" required>
    </div>

    <div class="field">
      <label for="no_telepon">No. Telepon:</label>
      <input type="text" id="no_telepon" name="no_telepon" value="<%= pasien.no_telepon %>" required>
    </div>

    <div class="field">
      <label for="alamat">Alamat:</label>
      <textarea id="alamat" name="alamat" rows="3"><%= pasien.alamat %></textarea>
    </div>

    <div class="field">
      <label for="berat_badan">Berat Badan (kg):</label>
      <input type="number" id="berat_badan" name="berat_badan" value="<%= pasien.berat_badan %>" min="1" max="500" step="0.1" required>
    </div>

    <button type="submit" class="btn">Simpan</button>
    <a href="/pasien">Batal</a>
  </form>
</div>

<%- include('../partials/footer') %>